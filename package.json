{
  "name": "winproducts-x-automation",
  "version": "1.4.0",
  "private": true,
  "description": "Turkish X automation with official Chrome Web Store extension installer and fail-closed real screenshots",
  "license": "MIT",
  "scripts": {
    "preview": "node src/prepare.js --preview",
    "prepare": "node src/prepare.js",
    "post:dry": "node src/index.js --dry-run",
    "post": "node src/index.js",
    "test": "node --test tests/*.test.js",
    "doctor": "node src/doctor.js",
    "visual:preview": "node src/prepare.js --preview --date 2026-11-01",
    "capture": "node src/capture-extension.js",
    "preview:template": "ALLOW_ILLUSTRATIVE_PREVIEW=true node src/prepare.js --preview --date 2026-11-01",
    "extension:find": "node src/extension-path.js",
    "capture:interactive": "node src/capture-extension.js --interactive",
    "research:add": "node src/research-queue.js add",
    "research:list": "node src/research-queue.js list",
    "research:approve": "node src/research-queue.js approve",
    "research:discover": "node src/discover-products.js",
    "preflight": "node src/preflight.js",
    "research:annotate": "node src/research-queue.js annotate",
    "capture:desktop-check": "node src/desktop-check.js",
    "extension:install": "python3 scripts/install_winproducts_extension.py",
    "extension:smoke": "node src/extension-smoke.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sharp": "^0.34.0",
    "twitter-api-v2": "^1.29.0"
  },
  "optionalDependencies": {
    "playwright": "^1.56.1"
  }
}
